# Alertmanager configuration template.
#
# HOW TO USE:
#   1. Copy this file to a location OUTSIDE the git repository (it may contain secrets):
#        cp monitoring/alertmanager-config.yaml.example /tmp/alertmanager-config.yaml
#
#   2. Edit /tmp/alertmanager-config.yaml — fill in your Slack webhook URL,
#      SMTP credentials, or other receiver details.
#
#   3. Set the path in secrets.env:
#        ALERTMANAGER_CONFIG_FILE=/tmp/alertmanager-config.yaml
#
#   4. Run the bootstrap script to upload the config to AWS Secrets Manager:
#        set -a; . external-secrets/secrets.env; set +a
#        external-secrets/bootstrap-aws-secrets.sh
#
#   The ExternalSecret "alertmanager-config-secret" (namespace: monitoring) will sync
#   the content as the key "alertmanager.yaml" in the Kubernetes Secret, which
#   kube-prometheus-stack reads via alertmanagerSpec.configSecret.

global:
  resolve_timeout: 5m

  # SMTP (email) — uncomment and fill in if using email notifications
  # smtp_from: 'alertmanager@example.com'
  # smtp_smarthost: 'smtp.gmail.com:587'
  # smtp_auth_username: 'alertmanager@example.com'
  # smtp_auth_password: 'your-app-password'
  # smtp_require_tls: true

route:
  group_by: ['alertname', 'namespace', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  receiver: 'default'

  routes:
    - matchers:
        - severity = "critical"
      receiver: 'critical'
      group_wait: 10s
      repeat_interval: 1h

    - matchers:
        - alertname = "Watchdog"
      receiver: 'null'

receivers:
  # 아무 알림도 보내지 않는 blackhole receiver
  - name: 'null'

  # 기본 수신자 — 원하는 채널로 교체하세요
  - name: 'default'
    # 아래 중 하나를 활성화하세요

    # --- Slack ---
    # slack_configs:
    #   - api_url: 'https://hooks.slack.com/services/T.../B.../...'
    #     channel: '#alerts'
    #     send_resolved: true
    #     title: '[{{ .Status | toUpper }}] {{ .GroupLabels.alertname }}'
    #     text: |
    #       {{ range .Alerts }}
    #       *Alert:* {{ .Annotations.summary }}
    #       *Description:* {{ .Annotations.description }}
    #       *Namespace:* {{ .Labels.namespace }}
    #       {{ end }}

    # --- Email ---
    # email_configs:
    #   - to: 'team@example.com'
    #     send_resolved: true

  - name: 'critical'
    # Slack_configs:
    #   - api_url: 'https://hooks.slack.com/services/T.../B.../...'
    #     channel: '#alerts-critical'
    #     send_resolved: true

inhibit_rules:
  # critical 알림이 발생하면 같은 alertname/namespace의 warning을 억제
  - source_matchers:
      - severity = "critical"
    target_matchers:
      - severity = "warning"
    equal: ['alertname', 'namespace']
