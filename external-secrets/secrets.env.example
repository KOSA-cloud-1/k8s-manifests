# Copy this file outside Git, fill the values, then source it before running:
#   set -a
#   . /tmp/kosa-secrets.env
#   set +a
#   external-secrets/bootstrap-aws-secrets.sh

# AWS CLI target region and secret name prefix.
AWS_REGION=ap-northeast-2
SECRET_PREFIX=prod

# prod/mariadb
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=employees
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_DB_NAME=employees
JWT_SECRET_KEY=
ADMIN_PASSWORD=

# prod/ceph: Ceph RGW S3 API for photo-service and backup source.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# prod/ceph-rbd: value from `ceph auth get-key client.TEAM1`.
CEPH_RBD_USER_KEY=

# prod/aws: backup destination AWS S3 credentials.
# These are intentionally prefixed with BACKUP_ so they do not conflict with
# the AWS CLI credentials used to write Secrets Manager.
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_S3_BUCKET=
BACKUP_AWS_REGION=ap-northeast-2

# prod/monitoring/grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# prod/monitoring/alertmanager
# Prefer a file path. ALERTMANAGER_CONFIG is also accepted by the script.
ALERTMANAGER_CONFIG_FILE=
